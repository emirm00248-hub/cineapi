@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="text-danger">Se produjo un error</h1>
<h2 class="text-danger">No pudimos completar la solicitud.</h2>

@if (Model.ShowRequestId)
{
    <p class="text-muted">Código de referencia: <code>@Model.RequestId</code></p>
}

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <p>@Model.Message</p>
}
